# ==============================================================================
# Project Baca — Production environment (.env.production.example)
# Copy to `.env.production`, fill every value, then `make prod-build prod-up`.
# Compose reads this file; the server, worker, and edge services receive the
# variables listed in docker-compose.prod.yml. Never commit `.env.production`.
# ==============================================================================

# Public domain name served by the edge (Caddy obtains the certificate).
DOMAIN=baca.example.com

# Postgres superuser password for the bundled database service.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# JWT signing secret: at least 32 random characters.
JWT_SECRET=replace-with-at-least-32-random-characters

# Object storage keys (bundled MinIO, or point S3_ENDPOINT at R2/S3).
S3_ACCESS_KEY_ID=replace-access-key
S3_SECRET_ACCESS_KEY=replace-secret-key
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET_EPUBS=baca-epubs
# S3_BUCKET_COVERS=baca-covers
# S3_FORCE_PATH_STYLE=true

# Transactional email (OTP codes). Signup fails closed when SMTP is down.
# STARTTLS on 587 with authentication is the expected production setup.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM_EMAIL=no-reply@baca.example.com
SMTP_FROM_NAME=Rotaria

# Gemini API key for embeddings and insight generation.
GEMINI_API_KEY=replace-with-gemini-key
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL_NAME=gemini-embedding-2

# Per-IP cap on unauthenticated catalog and insight reads per minute.
PUBLIC_RATE_LIMIT_PER_MINUTE=600

# Header the edge sets with the real client address. Caddyfile.prod writes
# X-Forwarded-For and strips the rest; behind Cloudflare set cf-connecting-ip
# and configure Caddy's trusted_proxies for its ranges.
# TRUSTED_IP_HEADER=x-forwarded-for
