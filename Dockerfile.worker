# Project Baca — ingestion worker image (Redis Streams consumer).
FROM python:3.15-slim@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928
WORKDIR /worker
COPY python_worker/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY python_worker/worker.py ./
# EPUBs are parsed in memory; the worker needs no writable path, so it runs
# as an unprivileged id and skips bytecode caches it could not write.
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD ["python", "worker.py", "--healthcheck"]
CMD ["python", "worker.py"]
