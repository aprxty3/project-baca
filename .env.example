# Project Baca local configuration. Copy to .env; every value below works
# with docker-compose.yml. Production values: .env.production.example.

# Server
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_FORMAT=text
# With TRUST_PROXY_HEADERS=true the client address is read from
# TRUSTED_IP_HEADER only; the edge must overwrite that header (Caddy sets
# X-Forwarded-For; behind Cloudflare use cf-connecting-ip).
TRUST_PROXY_HEADERS=false
TRUSTED_IP_HEADER=x-forwarded-for
# Per-IP cap on unauthenticated reads per minute; 0 disables it (dev and
# tests share one fallback IP). Production compose sets 600.
PUBLIC_RATE_LIMIT_PER_MINUTE=0

# Auth
JWT_SECRET=super-secret-jwt-key-replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRY_MINUTES=1440
JWT_REFRESH_EXPIRY_DAYS=14

# PostgreSQL 17 + pgvector
DATABASE_URL=postgres://baca_user:baca_password@localhost:5433/project_baca_db
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5
# DATABASE_CONNECT_TIMEOUT_SECS=10
# DATABASE_IDLE_TIMEOUT_SECS=300

# Redis 7 (OTP, sessions, rate limits, streams)
REDIS_URL=redis://localhost:6380/0

# Object storage (MinIO locally; any S3-compatible store)
S3_ENDPOINT=http://localhost:9005
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_EPUBS=baca-epubs
S3_BUCKET_COVERS=baca-covers
S3_FORCE_PATH_STYLE=true

# Email (Mailpit locally). SMTP_SECURITY: starttls (default) or none.
# Credentials are sent only when SMTP_USER is set.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@projectbaca.local
SMTP_FROM_NAME="Project Baca"

# AI (server embeds search queries; the worker embeds chunks and writes
# cards and recaps). EMBEDDING_PROVIDER: gemini or fastembed (stub).
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
EMBEDDING_MODEL_NAME=gemini-embedding-2
EMBEDDING_DIMENSION=768
# Worker only
# LLM_MODEL_NAME=gemini-flash-latest
# RECLAIM_IDLE_MS=300000

# Web build only: baked into the WASM bundle by make build.
# API_BASE_URL=http://localhost:8080/api/v1
