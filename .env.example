# ==============================================================================
# Project Baca — Konfigurasi Lingkungan (.env.example)
# Salin berkas ini ke `.env` untuk penggunaan lokal: cp .env.example .env
# ==============================================================================

# Server Core (Axum)
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Keamanan & JWT
JWT_SECRET=super-secret-jwt-key-replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# PostgreSQL 17 + pgvector (Sesuai docker-compose.yml)
DATABASE_URL=postgres://baca_user:baca_password@localhost:5433/project_baca_db
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# Redis 7 (Streams, Caching, Rate Limiting)
REDIS_URL=redis://localhost:6380/0

# Object Storage (MinIO Lokal / Cloudflare R2 / AWS S3)
S3_ENDPOINT=http://localhost:9005
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_EPUBS=baca-epubs
S3_BUCKET_COVERS=baca-covers
S3_FORCE_PATH_STYLE=true

# Email Transaksional (Mailpit Lokal)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@projectbaca.local
SMTP_FROM_NAME="Project Baca"

# AI & Embedding Provider Configuration
# Pilihan Provider: "gemini" (Google GenAI API - Zero GPU, cloud) atau "fastembed" (CPU ONNX lokal)
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
EMBEDDING_MODEL_NAME=text-embedding-004
EMBEDDING_DIMENSION=768
