# ==============================================================================
# Project Baca — Environment Configuration (.env.example)
# Copy to `.env` for local development: cp .env.example .env
# ==============================================================================

# Server Core (Axum)
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_FORMAT=text
# Trust CF-Connecting-IP / X-Real-IP / X-Forwarded-For for rate limiting.
# Keep false unless the edge proxy overwrites these headers (else spoofable).
TRUST_PROXY_HEADERS=false
# Per-IP cap on unauthenticated catalog/insight reads per minute. 0 disables
# it (dev + tests share one fallback IP); production compose sets 600.
PUBLIC_RATE_LIMIT_PER_MINUTE=0

# Security & JWT
JWT_SECRET=super-secret-jwt-key-replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRY_MINUTES=1440
JWT_REFRESH_EXPIRY_DAYS=14
# NOTE: production compose pins JWT_ACCESS_EXPIRY_MINUTES=60 to shrink the
# JWT-role staleness window (RBAC trusts the `role` claim; see BL-11).

# PostgreSQL 17 + pgvector (Matching docker-compose.yml)
DATABASE_URL=postgres://baca_user:baca_password@localhost:5433/project_baca_db
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# Redis 7 (Streams, Caching, Rate Limiting)
REDIS_URL=redis://localhost:6380/0

# Object Storage (Local MinIO / Cloudflare R2 / AWS S3)
S3_ENDPOINT=http://localhost:9005
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_EPUBS=baca-epubs
S3_BUCKET_COVERS=baca-covers
S3_FORCE_PATH_STYLE=true

# Transactional Email (Local Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@projectbaca.local
SMTP_FROM_NAME="Project Baca"

# AI & Embedding Provider Configuration
# Frontend API base is baked at Trunk build time (no runtime env in WASM):
# override via `make build API_BASE_URL=https://example.com/api/v1`.
# API_BASE_URL=http://localhost:8080/api/v1
# Options: "gemini" (Google GenAI API) or "fastembed" (local ONNX CPU)
# Supports both EMBEDDING_PROVIDER / AI_PROVIDER, and GEMINI_API_KEY / AI_API_KEY
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
EMBEDDING_MODEL_NAME=gemini-embedding-2
EMBEDDING_DIMENSION=768

